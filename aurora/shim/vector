// A minimal std::vector: CloudSeed only fills small seed tables with
// push_back, indexes them, and replaces them (by move) when a seed or a line
// setting changes. Storage goes back to the allocator (runtime.h).
#ifndef AURORA_SHIM_VECTOR
#define AURORA_SHIM_VECTOR
#include <stddef.h>
void* operator new(size_t);
void operator delete(void*) noexcept;
namespace std {
template <class T> class vector {
 public:
  vector() {}
  vector(const vector& o) { *this = o; }
  vector(vector&& o) : p(o.p), n(o.n), cap(o.cap) { o.p = nullptr; o.n = o.cap = 0; }
  ~vector() { operator delete(p); }
  vector& operator=(const vector& o) {
    if (this == &o) return *this;
    n = 0;
    reserve(o.n);
    for (size_t i = 0; i < o.n; i++) p[i] = o.p[i];
    n = o.n;
    return *this;
  }
  vector& operator=(vector&& o) {
    if (this == &o) return *this;
    operator delete(p);
    p = o.p; n = o.n; cap = o.cap;
    o.p = nullptr; o.n = o.cap = 0;
    return *this;
  }
  void reserve(size_t c) {
    if (c <= cap) return;
    T* q = (T*)operator new(c * sizeof(T));
    for (size_t i = 0; i < n; i++) q[i] = p[i];
    operator delete(p);
    p = q; cap = c;
  }
  void push_back(const T& v) { if (n == cap) reserve(cap ? 2 * cap : 16); p[n++] = v; }
  T& operator[](size_t i) { return p[i]; }
  const T& operator[](size_t i) const { return p[i]; }
  size_t size() const { return n; }
  T* data() { return p; }
  void clear() { n = 0; }
 private:
  T* p = nullptr;
  size_t n = 0, cap = 0;
};
}
#endif
